import "oaidl.idl";
import "ocidl.idl";

typedef struct NOTIFICATION_USER_INPUT_DATA
{
    [string] LPCWSTR Key;
    [string] LPCWSTR Value;
} NOTIFICATION_USER_INPUT_DATA;

[
    object,
    uuid(53e31837-6600-4a81-9395-75cffe746f94),
    pointer_default(ref)
]
interface INotificationActivationCallback : IUnknown
{
    HRESULT Activate( [in, string] LPCWSTR appUserModelId, [in, string, unique] LPCWSTR invokedArgs,
                      [in, unique, size_is(count)] const NOTIFICATION_USER_INPUT_DATA *data, [in] ULONG count );
}
